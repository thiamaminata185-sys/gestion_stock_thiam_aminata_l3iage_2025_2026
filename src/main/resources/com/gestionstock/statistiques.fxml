<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="570.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestionstock.controller.StatistiquesController">
    <content>
        <VBox spacing="18.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Du" />
                        <DatePicker fx:id="dateDebut" prefWidth="140.0" />
                        <Label text="au" />
                        <DatePicker fx:id="dateFin" prefWidth="140.0" />
                        <Button mnemonicParsing="false" onAction="#appliquerFiltre" style="-fx-background-color: orange;" text="Filtrer" />
                        <Button mnemonicParsing="false" onAction="#reinitialiserFiltre" text="Réinitialiser" />
                    </children>
                </HBox>

                <HBox spacing="15.0">
                    <children>
                        <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: green; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 11;" text="Valeur totale du stock" />
                                <Label fx:id="labelValeurStock" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" text="—" />
                            </children>
                            <padding><Insets bottom="14.0" left="12.0" right="12.0" top="14.0" /></padding>
                        </VBox>
                        <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: blue; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 11;" text="Produit le + mouvementé">
                           <opaqueInsets>
                              <Insets />
                           </opaqueInsets></Label>
                                <Label fx:id="labelProduitTop" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;" text="—" wrapText="true" />
                            </children>
                            <padding><Insets bottom="14.0" left="12.0" right="12.0" top="14.0" /></padding>
                        </VBox>
                        <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: yellow; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: black; -fx-font-size: 11;" text="Catégorie + forte valeur" />
                                <Label fx:id="labelCategorieTop" style="-fx-font-size: 14; -fx-font-weight: bold;" text="—" wrapText="true" />
                            </children>
                            <padding><Insets bottom="14.0" left="12.0" right="12.0" top="14.0" /></padding>
                        </VBox>
                    </children>
                </HBox>
                <HBox spacing="15.0">
                    <children>
                        <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: #42f5d1; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: black; -fx-font-size: 11;" text="Fournisseur + de produits" />
                                <Label fx:id="labelFournisseurTop" style="-fx-font-size: 14; -fx-font-weight: bold;" text="—" wrapText="true" />
                            </children>
                            <padding><Insets bottom="14.0" left="12.0" right="12.0" top="14.0" /></padding>
                        </VBox>
                        <VBox alignment="CENTER" spacing="6.0" style="-fx-background-color: red; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 11;" text="Sorties vers rupture évitée" />
                                <Label fx:id="labelRuptureEvitee" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" text="—" />
                            </children>
                            <padding><Insets bottom="14.0" left="12.0" right="12.0" top="14.0" /></padding>
                        </VBox>
                    </children>
                </HBox>

                <BarChart fx:id="graphiqueBarres" prefHeight="280.0" title="Quantité Entrée vs Sortie par mois">
                    <xAxis>
                        <CategoryAxis fx:id="axeXMois" label="Mois" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Quantité" />
                    </yAxis>
                </BarChart>

                <PieChart fx:id="graphiqueCamembert" prefHeight="300.0" title="Répartition de la valeur de stock par catégorie" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </content>
</ScrollPane>
