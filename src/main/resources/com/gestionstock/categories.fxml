<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="680.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.CategorieController"
>
    <children>
        <HBox spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#ouvrirAjout" prefWidth="140.0" styleClass="btn-primaire" text="+ Nouvelle Catégorie" />
                <Button fx:id="boutonSupprimer" mnemonicParsing="false" onAction="#supprimerCategorie" prefWidth="90.0" text="Supprimer" styleClass="supprimer" />
            </children>
        </HBox>
        <TableView fx:id="tableCategories" prefWidth="640.0">
            <columns>
                <TableColumn fx:id="colonneNom" prefWidth="150.0" text="Nom" />
                <TableColumn fx:id="colonneDescription" prefWidth="230.0" text="Description" />
                <TableColumn fx:id="colonneNbProduits" prefWidth="150.0" text="Nb. produits rattachés" />
                <TableColumn fx:id="colonneActions" prefWidth="160.0" text="Actions" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
