<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="700.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.FournisseurController"
>
    <children>
        <HBox spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#ouvrirAjout" prefWidth="150.0" styleClass="btn-primaire" text="+ Nouveau Fournisseur" />
                <Button fx:id="boutonSupprimer" mnemonicParsing="false" onAction="#supprimerFournisseur" prefWidth="90.0" text="Supprimer" styleClass="supprimer"/>
            </children>
        </HBox>
        <TableView fx:id="tableFournisseurs" prefWidth="660.0">
            <columns>
                <TableColumn fx:id="colonneNom" prefWidth="140.0" text="Nom" />
                <TableColumn fx:id="colonneEmail" prefWidth="180.0" text="Email" />
                <TableColumn fx:id="colonneTel" prefWidth="100.0" text="Téléphone" />
                <TableColumn fx:id="colonneNbProduits" prefWidth="130.0" text="Nb. produits fournis" />
                <TableColumn fx:id="colonneActions" prefWidth="160.0" text="Actions" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
